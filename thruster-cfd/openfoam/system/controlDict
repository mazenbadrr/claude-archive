/*--------------------------------*- C++ -*----------------------------------*\
| MSU-T76 bollard — steady MRF (simpleFoam).                                    |
| Forces on the propeller give thrust (Fz) and shaft torque (Mz);              |
| scripts/post.py converts them to KT, KQ, thrust[N], torque, power.           |
\*---------------------------------------------------------------------------*/
FoamFile { version 2.0; format ascii; class dictionary; object controlDict; }
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     simpleFoam;
startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         2500;          // SIMPLE iterations
deltaT          1;
writeControl    timeStep;
writeInterval   500;
purgeWrite      2;
writeFormat     ascii;
writePrecision  8;
timeFormat      general;
runTimeModifiable true;

functions
{
    forces_propeller
    {
        type            forces;
        libs            (forces);
        patches         (propeller);
        rho             rhoInf;
        rhoInf          998.2;        // water density (kinematic solver)
        CofR            (0 0 0);
        writeControl    timeStep;
        writeInterval   25;
    }
    forces_duct
    {
        type            forces;
        libs            (forces);
        patches         (duct);
        rho             rhoInf;
        rhoInf          998.2;
        CofR            (0 0 0);
        writeControl    timeStep;
        writeInterval   25;
    }
    yPlus
    {
        type            yPlus;
        libs            (fieldFunctionObjects);
        writeControl    writeTime;
    }
    minMaxP             // for the cavitation check (min pressure coeff)
    {
        type            fieldMinMax;
        libs            (fieldFunctionObjects);
        fields          (p);
        writeControl    timeStep;
        writeInterval   100;
    }
    residuals
    {
        type            solverInfo;
        libs            (utilityFunctionObjects);
        fields          (U p k omega);
        writeControl    timeStep;
        writeInterval   1;
    }
}
// ************************************************************************* //
