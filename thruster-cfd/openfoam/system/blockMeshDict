/*--------------------------------*- C++ -*----------------------------------*\
| Background box of still water around the thruster (bollard domain).          |
| ~6 prop-radii sideways, room up/downstream for the jet. Base cell ~20 mm;    |
| snappyHexMesh refines down to the blades.                                    |
\*---------------------------------------------------------------------------*/
FoamFile { version 2.0; format ascii; class dictionary; object blockMeshDict; }
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
scale   1;

xmin -0.23; xmax 0.23;
ymin -0.23; ymax 0.23;
zmin -0.30; zmax  0.62;

vertices
(
    ($xmin $ymin $zmin) ($xmax $ymin $zmin) ($xmax $ymax $zmin) ($xmin $ymax $zmin)
    ($xmin $ymin $zmax) ($xmax $ymin $zmax) ($xmax $ymax $zmax) ($xmin $ymax $zmax)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (24 24 46) simpleGrading (1 1 1)
);

edges ();

boundary
(
    farfield
    {
        type patch;
        faces
        (
            (0 3 2 1) (4 5 6 7)   // zmin, zmax
            (0 1 5 4) (2 3 7 6)   // ymin, ymax
            (1 2 6 5) (0 4 7 3)   // xmax, xmin
        );
    }
);
